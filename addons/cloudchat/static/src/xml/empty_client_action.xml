<?xml version="1.0" encoding="UTF-8"?>
<templates id="cloudchat_templates" xml:space="preserve">
  <t t-name="cloudchat.CloudChatIframe">
    <div class="o_form_view o_cloudchat_root"
         style="display:flex;flex-direction:column;height:100%;min-height:0;">
      <div class="o_xxl_padded">
        <h1>CloudChat</h1>
        <p>Abrindo Chatwoot (localhost:3000) dentro do Odoo.</p>
      </div>

      <div class="cloudchat-iframe-wrap" style="flex:1 1 auto;min-height:0;">
        <iframe
          src="http://localhost:3000"
          style="width:100%;height:100%;border:0;"
          sandbox="allow-forms allow-modals allow-popups allow-popups-to-escape-sandbox allow-scripts allow-same-origin"
          referrerpolicy="no-referrer"
          loading="eager">
        </iframe>
      </div>
    </div>
  </t>
</templates>
