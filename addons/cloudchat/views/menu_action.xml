<odoo>
  <data>
    <!-- Client action que aponta para nossa action JS -->
    <record id="action_cloudchat_empty" model="ir.actions.client">
      <field name="name">CloudChat</field>
      <field name="tag">cloudchat.empty</field>
    </record>

    <!-- Menu raiz do app -->
    <menuitem id="menu_cloudchat_root" name="CloudChat" sequence="10"/>

    <!-- Item que abre a tela vazia -->
    <menuitem id="menu_cloudchat_dashboard"
              name="Dashboard"
              parent="menu_cloudchat_root"
              action="action_cloudchat_empty"
              sequence="10"/>
  </data>
</odoo>
